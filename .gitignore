.mcp.json
build/
*.egg-info/

# Local-only deployer overlays / private plugins — keep vendor code out of the open core.
# Brand/vendor themes now live here (e.g. overlay/themes/<name>/) and load via SURVEY_THEMES_DIR
# or the default ./overlay/themes scan. See docs/dev/DESIGN_DECISIONS.md.
/overlay/

# Brand/vendor-specific surveys, assets, and templates stay OUT of the open core — keep them in a
# private overlay/plugin (see /overlay/ above) or outside the repo. The generic templates mechanism
# (templates/README.md, docs/dev/TEMPLATES.md) ships; brand examples do not.

# Editor workspace files (personal/local)
*.code-workspace

# Optional local denylist for the vendor-neutrality test (tests/test_api_auth.py) — never committed.
tests/.denylist
