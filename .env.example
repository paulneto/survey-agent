# survey-agent environment — copy to `.env` and edit. (In production, mirror these in your secrets
# manager.) NOTE: comments are on their OWN lines, never inline after a value — some loaders/IDEs
# (e.g. the VSCode Python extension) inject this file verbatim, and a trailing `# comment` would
# become part of the value. For a quick CLI/runtime try-out you only need ANTHROPIC_API_KEY (below).

# --- Bring your own model (powers `author`, conversational mode, critique, insights, persona tests) ---
# Set ONE of these; everything else (validate/simulate/demo) runs offline without a key.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# SURVEY_LLM=auto                  # auto (default) | anthropic | openai | stub
# SURVEY_LLM_MODEL=                # override the model id (else a sensible default per provider)

# --- Core ---
SURVEY_ENV=local
# host that appears in emitted survey_url
SURVEY_PUBLIC_BASE_URL=http://localhost:8000
# default identity url-vars when a survey omits settings.identity (respondent id + response id).
# Defaults to the generic uid/rid; a deployment whose panel passes other names can set them here.
# SURVEY_RESPONDENT_VAR=uid
# SURVEY_RESPONSE_VAR=rid
# render the survey title as an <h1> banner atop every page (per-survey settings.show_title wins).
# SURVEY_SHOW_TITLE=true
# brand mark for the operator console + the hosted service landing page (neutral default).
# SURVEY_CONSOLE_BRAND=survey-agent
# SURVEY_BRAND_TAGLINE=An open survey engine.
# hosted multi-survey landing: default is a neutral holding page; =1 lists the live surveys instead.
# SURVEY_LANDING_LIST=
# capture per-response network metadata (ip / user-agent / client fingerprint) as fraud/bot signals.
# OFF by default — it's PII; it rides inside the response so DSAR-export/erasure cover it. See docs/DATA_SECURITY.md.
# SURVEY_CAPTURE_CLIENT_META=
# lifecycle serving gate: which states the runtime serves to respondents (comma-separated; default live).
# pre-live states show a "not open yet" page. Widen during a migration, e.g. live,approved,tested.
SURVEY_SERVE_STATES=live
# token that lets an operator preview a not-yet-live survey: /s/<id>?preview=<token> (collects no data).
# the console mints one for its local preview runtime; set the same value to preview a shared runtime.
# SURVEY_PREVIEW_TOKEN=change-me
# storage seam (sessions/responses/quotas): memory | file | mongo | http | your_pkg.store:YourStore
# (http = read through the API gateway; uses SURVEY_API_BASE/TOKEN below)
SURVEY_STORE=memory
# definition source seam: file (default — surveys in SURVEY_DIR, lifecycle in .registry.json; publish =
# your deploy step) | mongo (reference runtime backend: publish + pause/close are store writes, no
# redeploy) | http (talk to the API gateway, not a direct DB) | your_pkg.defs:YourDefinitions.
# Mongo reuses SURVEY_MONGODB_URI/DB below.
SURVEY_DEFINITION_SOURCE=file
# API gateway (`survey-agent api`): the authenticated front door to the data backend. Run it where the
# DB lives (with SURVEY_DEFINITION_SOURCE=mongo + SURVEY_STORE=mongo); point clients at it with
# SURVEY_DEFINITION_SOURCE=http / SURVEY_STORE=http. SURVEY_API_TOKEN is the bearer token (unset = no auth).
# SURVEY_API_BASE=http://127.0.0.1:8001
# SURVEY_API_TOKEN=change-me
# --- Gateway auth ([auth] extra): layered on top of SURVEY_API_TOKEN. Configure any of these and the
# gateway requires a principal (bearer token OR sa_ API key OR Google sign-in); configure none and it
# stays open (local/dev). Per-user sa_ keys are managed at /keys; see docs/HOSTING.md.
# Google OAuth (both set ⇒ sign-in enabled; /auth/google/login):
# SURVEY_GOOGLE_CLIENT_ID=
# SURVEY_GOOGLE_CLIENT_SECRET=
# session-cookie signing key — MUST be a strong secret once OAuth is on (the gateway refuses to start
# with the dev placeholder + OAuth configured, so sessions can't be forged):
# SURVEY_SESSION_JWT_KEY=dev-only-change-me
# restrict sign-in to one Google hosted domain (empty = any signed-in Google account):
# SURVEY_OAUTH_ALLOWED_DOMAIN=
# server-to-server key provisioning (POST /provision/cli-token); unset ⇒ that endpoint returns 404:
# SURVEY_PROVISION_API_KEY=
# context enrichment: static | firebolt | your_pkg.enrich:YourProvider
# (firebolt = shipped reference warehouse adapter; an import path plugs in any behavioral DB)
SURVEY_ENRICH=static
# warehouse column holding the respondent id for enrichment/trigger queries (default respondent_id;
# an event type in the catalog can override it with "id_field")
# SURVEY_ENRICH_ID_FIELD=respondent_id
# persona source for `pretest`: synthetic | your_pkg.personas:RealPersonaSource
SURVEY_PERSONAS=synthetic
# completion integration: none | redirect | webhook | panel | mailchimp | <installed plugin>
SURVEY_INTEGRATION=none
# where a completed respondent goes when a survey's redirect kind is "default"
SURVEY_DEFAULT_REDIRECT_URL=
# default folder for generated reports / dashboards / exports (else the repo root). also: output.dir in
# survey-agent.config.yaml. an explicit --out on a command always wins.
SURVEY_OUTPUT_DIR=reports

# --- MongoDB (used by SURVEY_STORE=mongo and/or SURVEY_DEFINITION_SOURCE=mongo) ---
SURVEY_MONGODB_URI=mongodb://localhost:27017
SURVEY_MONGODB_DB=survey_agent

# --- Uploads / blob store (only when a survey has a `file` question) ---
# Where the bytes of file-upload answers go (the response stores only a reference). local | s3 | import path.
SURVEY_UPLOAD_STORE=local
# local backend: directory for uploaded files
SURVEY_UPLOAD_DIR=./survey_uploads
# local backend: optional public prefix to serve uploads at
# SURVEY_UPLOAD_BASE_URL=
# s3 backend (pip install ".[s3]") — bucket + standard AWS creds/region from the environment:
# SURVEY_UPLOAD_BUCKET=my-survey-uploads
# SURVEY_UPLOAD_PREFIX=uploads
# AWS_REGION=us-east-1   AWS_ACCESS_KEY_ID=…   AWS_SECRET_ACCESS_KEY=…   (or an instance role)

# --- Browser-redirect passback (only when SURVEY_INTEGRATION=redirect) ---
# On a terminal, the respondent's browser is 302'd to a per-status URL with the passback vars appended
# (the classic panel bounce: completer -> complete URL, screen-out -> terminate URL). A survey can
# override any terminal with a spec redirect of kind "url".
# SURVEY_REDIRECT_COMPLETE_URL=https://your-panel.example/complete
# SURVEY_REDIRECT_TERMINATED_URL=https://your-panel.example/terminate
# overquota only; falls back to the terminated URL when unset
# SURVEY_REDIRECT_OVERQUOTA_URL=
# url_variables appended to the redirect as query params (comma-separated)
SURVEY_REDIRECT_PASSBACK=uid,rid

# --- Panel passback (only when SURVEY_INTEGRATION=panel) ---
# The `panel` integration POSTs each lifecycle event to its own URL below (signed, idempotent).
# Leave a URL blank to not subscribe to that event. Set SURVEY_PANEL_CALLBACK_METHOD=GET to send
# the event as a query string instead of a signed JSON body.
# Payload = the neutral lifecycle event (event, status, survey/session ids, url_variables, idempotency_key).
SURVEY_PANEL_STARTED_URL=http://localhost:9000/panel/started
SURVEY_PANEL_COMPLETED_URL=http://localhost:9000/panel/completed
SURVEY_PANEL_TERMINATED_URL=http://localhost:9000/panel/terminated
SURVEY_PANEL_TERMINATED_BY_USER_URL=http://localhost:9000/panel/terminated-by-user
SURVEY_PANEL_CALLBACK_METHOD=POST
# Shared secret used to HMAC-sign the passback calls (X-Survey-Signature, same scheme as webhooks).
# REQUIRED before fielding via the panel integration — set a strong random value (e.g.
# `openssl rand -hex 32`). The runtime refuses to start if this is left as the dev placeholder
# while SURVEY_INTEGRATION=panel. Leave unset only if you intentionally want unsigned passbacks.
SURVEY_PANEL_SHARED_SECRET=dev-only-change-me

# --- Mailchimp (only when SURVEY_INTEGRATION=mailchimp) ---
# On completion, upsert the respondent into a Mailchimp audience with merge fields + tags.
# MAILCHIMP_API_KEY: e.g. abc123...-us21 (the -usXX datacenter is parsed out)
MAILCHIMP_API_KEY=
# the audience / list id
MAILCHIMP_LIST_ID=
# url_var or answer id that holds the email
MAILCHIMP_EMAIL_VAR=email
# completed (default) | always (also tag screen-outs)
MAILCHIMP_ON=completed
# status_if_new: transactional | subscribed | pending
MAILCHIMP_STATUS=transactional
# extra static tags, comma-separated
MAILCHIMP_TAGS=
# JSON {MERGE_TAG: "q:<qid>" | "url:<var>" | "var:<id>"}
MAILCHIMP_MERGE_MAP=

# --- Webhooks ---
# Shared secret for signing outbound webhooks. When set, every POST carries
# X-Survey-Signature: t=<ts>,v1=<hmac-sha256 of "{ts}.{body}"> — receivers verify with the same secret.
SURVEY_WEBHOOK_SECRET=

# --- Behavioral trigger sidecar (python -m survey_agent.sidecar.runner) ---
# When a trigger matches respondents, the sidecar POSTs one generic launch request (survey_id,
# survey_url, respondent_ids, audience, optional target_completes/budget) to this URL; your panel
# (or a thin adapter) offers the survey. See src/survey_agent/sidecar/panel_client.py for the contract.
# PANEL_LAUNCH_URL=https://your-panel.example/survey-launches
# optional bearer token sent as Authorization: Bearer <token>
# PANEL_LAUNCH_TOKEN=
# optional HMAC secret — signs the launch request (X-Survey-Signature, same scheme as webhooks)
# PANEL_LAUNCH_SECRET=
# directory of trigger JSON files (default: the packaged examples)
# SURVEY_TRIGGERS_DIR=./triggers
